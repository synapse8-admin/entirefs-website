# Public configuration only. SITE_URL defaults to the approved origin documented in LAUNCH_CHECKLIST.md.
SITE_URL=
# Set false to keep a staging installation noindexed even on the canonical hostname.
SITE_INDEXABLE=
# Optional ownership tokens; tags are emitted only when nonempty.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional public HTTPS form endpoint. Never put an API key or credential here.
# Must be owner-approved and perform validation/spam control server-side.
CONTACT_FORM_ENDPOINT=
# Supplied by the hosting platform.
PORT=
BASE_PATH=
